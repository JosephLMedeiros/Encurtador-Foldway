{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "color-no-hex": true,
    "selector-class-pattern": [
      "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
      { "message": "Use kebab-case com BEM: bloco__elemento--modificador" }
    ]
  },
  "ignoreFiles": ["src/styles/theme.css"]
}
