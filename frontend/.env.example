# Endereço base da API (sem barra final).
# Em desenvolvimento com mock ativo pode ser deixado vazio.
VITE_API_BASE_URL=http://localhost:3000

# Ativa o mock da API em vez de chamadas reais.
VITE_USE_MOCK=true

# Atraso artificial das respostas do mock em milissegundos (opcional).
VITE_MOCK_DELAY_MS=500

# Força o mock a rejeitar todas as chamadas com erro de rede simulado.
VITE_MOCK_ERROR=false
