    {
      "id": 20,
      "type": "table",
      "title": "Link do dia (24h, direto do Postgres)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT l.short_code AS \"código\", count(*) AS \"cliques 24h\", l.original_url AS \"destino\"\nFROM click_events e JOIN links l ON l.id = e.link_id\nWHERE e.clicked_at > now() - interval '24 hours'\nGROUP BY l.id ORDER BY 2 DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
